# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# Local OpenAI-compatible endpoint (vLLM etc). Loopback only by default.
VOXELTRACE_AI_BASE_URL=http://127.0.0.1:8000/v1
# VOXELTRACE_AI_MODEL=
# VOXELTRACE_AI_TIMEOUT_S=5
# Optional, only if the local server was started with --api-key:
# VOXELTRACE_AI_API_KEY=

# Keep project caches inside the workspace (replace <workspace> with its absolute path).
# VOXELTRACE_WORKSPACE=<workspace>
PIP_CACHE_DIR=<workspace>/tmp/pip-cache
HF_HOME=<workspace>/models/hf-cache
